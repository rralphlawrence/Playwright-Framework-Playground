{
  "name": "playground",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:headless": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:headless:stg": "set ENV=STG && npx playwright test",
    "test:headed:stg": "set ENV=STG && npx playwright test --headed",
    "allure:clean": "if exist allure-results rmdir /s /q allure-results && if exist allure-report rmdir /s /q allure-report",
    "allure:generate": "npx allure generate ./allure-results -o ./allure-report",
    "allure:open": "npx allure open ./allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.3",
    "allure-playwright": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.0"
  }
}
