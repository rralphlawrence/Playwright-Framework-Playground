# Environment selection: DEV, STG, or PROD
ENV=STG

# === Credentials (secrets - do NOT commit real values) ===
# DEV environment
DEV_USERNAME=your_dev_username
DEV_PASSWORD=your_dev_password

# STG environment
STG_USERNAME=your_stg_username
STG_PASSWORD=your_stg_password

# PROD environment
PROD_USERNAME=your_prod_username
PROD_PASSWORD=your_prod_password